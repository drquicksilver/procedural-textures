{
  "version": 5,
  "name": "Smiley",
  "description": "Transparent ramps used as clipping masks to build a smiley face over a noisy background.",
  "category": "effect",
  "ramps": {
    "eye": {
      "type": "stops",
      "stops": [
        {"position": 0, "colour": "#a9a9a9ff"},
        {"position": 0.5, "colour": "#696969ff"},
        {"position": 0.85, "colour": "#000000ff"},
        {"position": 1, "colour": "#00000000"}
      ]
    }
  },
  "texture": {
    "type": "layer",
    "top": {
      "type": "circular",
      "centre": [0.35, 0.4, 0],
      "radius": 0.065,
      "mode": "clamp",
      "ramp": {"name": "eye", "type": "named"}
    },
    "bottom": {
      "type": "layer",
      "top": {
        "type": "circular",
        "centre": [0.65, 0.4, 0],
        "radius": 0.065,
        "mode": "clamp",
        "ramp": {"name": "eye", "type": "named"}
      },
      "bottom": {
        "type": "layer",
        "top": {
          "type": "layer",
          "top": {
            "type": "linear",
            "from": [0.5, 0, 0],
            "to": [0.5, 1, 0],
            "mode": "clamp",
            "ramp": {
              "type": "stops",
              "stops": [
                {"position": 0, "colour": "#ffd700ff"},
                {"position": 0.45, "colour": "#ffd700ff"},
                {"position": 0.46, "colour": "#00000000"},
                {"position": 1, "colour": "#00000000"}
              ]
            }
          },
          "bottom": {
            "type": "circular",
            "centre": [0.5, 0.6, 0],
            "radius": 0.25,
            "mode": "clamp",
            "ramp": {
              "type": "stops",
              "stops": [
                {"position": 0, "colour": "#00000000"},
                {"position": 0.6, "colour": "#00000000"},
                {"position": 0.66, "colour": "#781e8cff"},
                {"position": 0.84, "colour": "#5a0f6eff"},
                {"position": 1, "colour": "#00000000"}
              ]
            }
          }
        },
        "bottom": {
          "type": "layer",
          "top": {
            "type": "circular",
            "centre": [0.5, 0.5, 0],
            "radius": 0.45,
            "mode": "clamp",
            "ramp": {
              "type": "stops",
              "stops": [
                {"position": 0, "colour": "#ffd700ff"},
                {"position": 0.7, "colour": "#ffd700ff"},
                {"position": 0.9, "colour": "#ff8c00ff"},
                {"position": 1, "colour": "#00000000"}
              ]
            }
          },
          "bottom": {
            "type": "perlin",
            "scale": [9, 9, 9],
            "mode": "clamp",
            "ramp": {
              "type": "stops",
              "stops": [
                {"position": 0, "colour": "#00008bff"},
                {"position": 0.45, "colour": "#708090ff"},
                {"position": 0.7, "colour": "#87ceebff"},
                {"position": 1, "colour": "#0000ffff"}
              ]
            }
          }
        }
      }
    }
  }
}
