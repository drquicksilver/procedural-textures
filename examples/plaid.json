{
  "version": 2,
  "name": "Plaid",
  "description": "Crossing translucent stripes over a base colour; one shared \"weave\" ramp makes both directions.",
  "category": "pattern",
  "ramps": {
    "weave": {
      "type": "stops",
      "mode": "wrap",
      "stops": [
        {"position": 0, "colour": "#0d2a4a99"},
        {"position": 0.3, "colour": "#0d2a4a99"},
        {"position": 0.3, "colour": "#00000000"},
        {"position": 0.45, "colour": "#00000000"},
        {"position": 0.45, "colour": "#e8c95ccc"},
        {"position": 0.5, "colour": "#e8c95ccc"},
        {"position": 0.5, "colour": "#00000000"},
        {"position": 1, "colour": "#00000000"}
      ]
    }
  },
  "texture": {
    "type": "layer",
    "top": {
      "type": "linear",
      "from": [0, 0.5],
      "to": [0.25, 0.5],
      "ramp": {"name": "weave", "type": "named"}
    },
    "bottom": {
      "type": "layer",
      "top": {
        "type": "linear",
        "from": [0.5, 0],
        "to": [0.5, 0.25],
        "ramp": {"name": "weave", "type": "named"}
      },
      "bottom": {"type": "flat", "colour": "#7a1f24ff"}
    }
  }
}
