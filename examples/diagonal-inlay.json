{
  "version": 5,
  "name": "Diagonal inlay",
  "description": "Gold-rimmed round medallions repeat on a diagonal grid, extruded through the solid.",
  "category": "pattern",
  "guide": {
    "role": "comparison",
    "tags": ["repeat", "transform-order"],
    "family": "Repeated medallions",
    "order": 101,
    "hint": "Swap the ordered domain children to compare translate→rotate with rotate→translate; Z projection retains visibility through the solid."
  },
  "texture": {
    "type": "domain",
    "base": {
      "type": "colourise",
      "mode": "clamp",
      "ramp": {
        "type": "stops",
        "stops": [
          {"position": 0, "colour": "#eff0d9ff"},
          {"position": 0.4, "colour": "#74afadff"},
          {"position": 0.55, "colour": "#183e57ff"},
          {"position": 0.7, "colour": "#d6b66cff"},
          {"position": 0.82, "colour": "#f6e8beff"},
          {"position": 1, "colour": "#183e57ff"}
        ]
      },
      "field": {
        "type": "scalar-domain",
        "domain": {"type": "scale", "scale": [1, 1, 0]},
        "source": {"type": "distance", "centre": [0.08, -0.04, 0], "radius": 0.1}
      }
    },
    "domain": {
      "type": "compose",
      "first": {"type": "translate", "offset": [0.5, 0.5, 0]},
      "second": {
        "type": "compose",
        "first": {"type": "rotate", "rotation": [0, 0, 35]},
        "second": {"type": "repeat", "period": [0.27, 0.27, 0]}
      }
    }
  }
}
