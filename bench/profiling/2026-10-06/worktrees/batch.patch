+
+-- Four-row tiles retain the baseline's four-row task boundaries, while each
+-- texture stage runs a vector kernel instead of a root closure per pixel.
+renderBatchImage :: Int -> Int -> (UV.Vector (Double, Double) -> UV.Vector Colour) -> Image PixelRGBA8
+renderBatchImage width height fn =
+  Image width height (VS.concat (withStrategy (parListChunk 1 rseq) tiles))
+  where
+    tiles = [tile start (min 4 (height - start)) | start <- [0, 4 .. height - 1]]
+    tile start count =
+      let coords = UV.generate (width * count) $ \i ->
+            (indexToUnit (i `mod` width) width, indexToUnit (start + i `div` width) height)
+          colours = fn coords
+      in VS.create $ do
+        bytes <- VSM.new (width * count * 4)
+        forM_ [0 .. width * count - 1] $ \i -> do
+          let PixelRGBA8 r g b a = toPixel (UV.unsafeIndex colours i)
+          VSM.unsafeWrite bytes (4 * i) r
+          VSM.unsafeWrite bytes (4 * i + 1) g
+          VSM.unsafeWrite bytes (4 * i + 2) b
+          VSM.unsafeWrite bytes (4 * i + 3) a
+        pure bytes
