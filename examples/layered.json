{
  "version": 5,
  "name": "Layered gradients",
  "description": "A transparent-to-blue horizontal gradient layered over a red-to-green vertical one.",
  "category": "colour",
  "guide": {
    "role": "study",
    "tags": ["alpha-over"],
    "order": 100,
    "hint": "Inspect the transparent blue top ramp and the opaque red/green backdrop separately."
  },
  "texture": {
    "type": "layer",
    "top": {
      "type": "linear",
      "from": [0, 0.5, 0],
      "to": [1, 0.5, 0],
      "mode": "clamp",
      "ramp": {
        "type": "stops",
        "stops": [
          {"position": 0, "colour": "#00000000"},
          {"position": 1, "colour": "#0000ffff"}
        ]
      }
    },
    "bottom": {
      "type": "linear",
      "from": [0.5, 0, 0],
      "to": [0.5, 1, 0],
      "mode": "clamp",
      "ramp": {
        "type": "stops",
        "stops": [
          {"position": 0, "colour": "#ff0000ff"},
          {"position": 1, "colour": "#008000ff"}
        ]
      }
    }
  }
}
