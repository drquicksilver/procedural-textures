{
  "name": "texture-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "pages:build": "node scripts/pages-build.mjs",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/gallery-cache.test.mjs",
    "test:watch": "vitest",
    "bench:cold-start": "node scripts/cold-start.mjs",
    "bench:cold-compile": "node scripts/cold-compile.mjs",
    "gpu:browser": "node scripts/gpu-browser.mjs",
    "gpu:compatibility": "node scripts/gpu-compatibility.mjs",
    "gpu:test": "node scripts/gpu-conformance.mjs",
    "gpu:watch": "node scripts/gpu-conformance.mjs --watch",
    "gpu:spike": "node scripts/gpu-spike.mjs",
    "e2e": "node scripts/editor-e2e.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.13.3",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
