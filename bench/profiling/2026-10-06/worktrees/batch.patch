+-- Prototype: evaluate each node over a tile of unboxed coordinate/colour
+-- buffers, preserving full Double precision until the final byte conversion.
+textureToBatchFn :: Texture -> UV.Vector (Double, Double) -> UV.Vector Colour
+textureToBatchFn texture =
+  case texture of
+    Layer top bottom ->
+      let topFn = textureToBatchFn top
+          bottomFn = textureToBatchFn bottom
+      in \coords -> UV.zipWith blend (topFn coords) (bottomFn coords)
+    Turbulence amount octaves omega lambda base ->
+      let baseFn = textureToBatchFn base
+          field = turbulenceFn octaves omega lambda
+          warp (x, y) =
+            let dx = amount * (field x y - 0.5)
+                dy = amount * (field (x + 19.1) (y + 7.7) - 0.5)
+            in (x + dx, y + dy)
+      in \coords -> baseFn (UV.map warp coords)
+    _ -> let fn = textureToImageFn texture in UV.map (uncurry fn)
