{
  "version": 5,
  "name": "Field-oriented hatching",
  "description": "A broad smooth noise field rotates fine sampling stripes around a fixed central pivot, producing colour-only directional hatching.",
  "category": "pattern",
  "guide": {
    "role": "composition",
    "tags": ["rotate-field", "noise", "sin", "3D"],
    "order": 100,
    "hint": "A broad smooth noise field rotates fine sampling stripes around a fixed central pivot, producing colour-only directional hatching."
  },
  "texture": {
    "type": "domain",
    "base": {
      "type": "colourise",
      "mode": "clamp",
      "ramp": {
        "type": "stops",
        "stops": [
          {"position": -1, "colour": "#20374fff"},
          {"position": -0.2, "colour": "#326476ff"},
          {"position": 0.2, "colour": "#9abbb1ff"},
          {"position": 0.7, "colour": "#e1c89aff"},
          {"position": 1, "colour": "#eee1b4ff"}
        ]
      },
      "field": {
        "type": "sin",
        "source": {
          "type": "multiply",
          "a": {
            "axis": "y",
            "type": "component",
            "source": {"type": "position"}
          },
          "b": {"type": "constant", "value": 150}
        }
      }
    },
    "domain": {
      "axis": [0, 0, 1],
      "type": "rotate-field",
      "centre": [0.5, 0.5, 0.5],
      "angle": {
        "type": "multiply",
        "a": {
          "type": "scalar-domain",
          "domain": {"type": "scale", "scale": [1.1, 1.1, 1.1]},
          "source": {"type": "noise"}
        },
        "b": {"type": "constant", "value": 180}
      }
    }
  }
}
